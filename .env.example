# Copie para .env e ajuste. NÃO versione o .env real.

# --- Postgres ---
POSTGRES_USER=officequest
POSTGRES_PASSWORD=troque-por-uma-senha-forte
POSTGRES_DB=officequest

# --- Dados iniciais ---
# false = banco limpo: só o catálogo curado (tipos de lançamento, objetivos, itens da loja).
# true = também cria o time fictício (Paulo, Marina, Diego, Aline) com horas inventadas.
SEED_DEMO_DATA=false

# --- Auth ---
# false = só o token assinado vale (o correto em produção e no beta).
# true aceita o header X-User-Id como login — porta dos fundos, use só para depurar.
AUTH_DEV_BYPASS=false
# Segredo de assinatura do JWT (>= 32 bytes). GERE UM NOVO.
JWT_KEY=troque-este-segredo-por-32-bytes-ou-mais____________

# --- Conta local (usuário + senha) --- o login do beta, não depende do Google.
AUTH_PASSWORD_ENABLED=true
# Cadastro aberto. Feche (false) para beta por convite e crie as contas você mesmo.
AUTH_ALLOW_REGISTRATION=true

# --- Google OAuth (opcional; pode entrar depois e ser vinculado às contas existentes) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_HOSTED_DOMAIN=

# --- LiveKit (A/V) ---
# LIVEKIT_URL vazio = usa o container local (perfil `local-livekit`); a voz so
# funciona na sua maquina/LAN. Para acesso EXTERNO (Cloudflare Tunnel) e obrigatorio
# apontar para a LiveKit Cloud: UDP nao passa por tunel HTTP.
# Pegue a URL em Project settings -> Project URL (prefixe com wss://).
LIVEKIT_URL=
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret_officequest_32chars_min!

# --- Economia do jogo ---
# Bônus único por usuário (inclusive os já existentes). 0 desliga; no beta use 10000.
GAME_WELCOME_GRANT_COINS=0
# Trocar a chave concede o bônus de novo. Manter não repete o crédito.
GAME_WELCOME_GRANT_KEY=beta-v1
# Fuso do time: onde o dia começa para metas diárias e teto de XP.
GAME_TZ_OFFSET=-3
