# Copie para .env e ajuste. NÃO versione o .env real.

# --- Postgres ---
POSTGRES_USER=officequest
POSTGRES_PASSWORD=troque-por-uma-senha-forte
POSTGRES_DB=officequest

# --- Auth ---
# DevBypass=true deixa o app rodar SEM Google (aceita X-User-Id) — bom para validar o build.
# Em produção de verdade: false + configure o Google OAuth abaixo.
AUTH_DEV_BYPASS=true
# Segredo de assinatura do JWT (>= 32 bytes). GERE UM NOVO.
JWT_KEY=troque-este-segredo-por-32-bytes-ou-mais____________

# --- Google OAuth (necessário se AUTH_DEV_BYPASS=false) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_HOSTED_DOMAIN=

# --- LiveKit (A/V) --- as duas devem bater com o backend
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret_officequest_32chars_min!
