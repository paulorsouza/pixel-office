# Copie este arquivo para  deploy\beta.env  e preencha com os dados da LiveKit Cloud.
# (deploy\beta.env NAO vai pro git.)
#
# A URL do projeto esta em Project settings -> Project URL (prefixe com wss://).
# A Key e a Secret estao em Settings -> Keys -> Create Key (a Secret aparece so uma vez).

LIVEKIT_URL=wss://virtual-office-manm5po3.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Contas do beta (usuario + senha) ---
# Segredo de assinatura do JWT (>= 32 bytes). GERE UM NOVO antes de abrir o beta:
# a chave padrao do appsettings deixa qualquer um forjar token.
JWT_KEY=
# false (padrao no beta) desliga o atalho X-User-Id. true so para depurar.
AUTH_DEV_BYPASS=false
# Cadastro aberto na tela de login. Ponha false para beta por convite.
AUTH_ALLOW_REGISTRATION=true
