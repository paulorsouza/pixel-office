# Copie este arquivo para  deploy\beta.env  e preencha com os dados da LiveKit Cloud.
# (deploy\beta.env NAO vai pro git.)
#
# A URL do projeto esta em Project settings -> Project URL (prefixe com wss://).
# A Key e a Secret estao em Settings -> Keys -> Create Key (a Secret aparece so uma vez).

LIVEKIT_URL=wss://virtual-office-manm5po3.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Contas do beta (usuario + senha) ---
# Segredo de assinatura do JWT (>= 32 bytes). GERE UM NOVO antes de abrir o beta:
# a chave padrao do appsettings deixa qualquer um forjar token.
JWT_KEY=
# false (padrao no beta) desliga o atalho X-User-Id. true so para depurar.
AUTH_DEV_BYPASS=false
# Cadastro aberto na tela de login. Ponha false para beta por convite.
AUTH_ALLOW_REGISTRATION=true

# --- Banco (Postgres) ---
# O beta usa o Postgres do docker-compose.dev.yml na propria maquina.
# Suba antes de rodar run-beta.ps1:  docker compose -f docker-compose.dev.yml up -d
DB_CONNECTION=Host=localhost;Port=5432;Database=officequest;Username=officequest;Password=officequest

# --- Economia do beta ---
# Todo usuario (inclusive quem ja existe) recebe este bonus UMA vez.
# Trocar GAME_WELCOME_GRANT_KEY concede de novo; manter a chave nao repete o credito.
GAME_WELCOME_GRANT_COINS=10000
GAME_WELCOME_GRANT_KEY=beta-v1

# Caixa do Beta Tester: todo usuario (inclusive quem ja existe) ganha UMA, com o
# catalogo inteiro dentro - 100 boosters de cada tipo, um de cada equipamento,
# veiculo e bau, e 5 de cada movel. Vem ligada no beta; false desliga.
# Trocar GAME_BETA_BOX_KEY entrega uma leva nova (util quando entra item novo).
# Sob demanda, sem mexer aqui: POST /api/admin/beta-box.
GAME_BETA_BOX=true
GAME_BETA_BOX_KEY=beta-box-v1
