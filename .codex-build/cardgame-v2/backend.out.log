          ELSE c."CardId"
      END AS "cardToken", c."Quantity" AS quantity, c."FirstAcquiredUtc" AS "firstAcquiredUtc"
      FROM "CardGameCollection" AS c
      WHERE c."UserId" = @profile_UserId AND c."Quantity" > 0
      ORDER BY c."CardId", c."IsShiny", c."ShinyBonusSide"
