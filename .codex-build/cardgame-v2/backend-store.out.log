      Executed DbCommand (2ms) [Parameters=[@profile_UserId='?' (DbType = Int32)], CommandType='Text', CommandTimeout='30']
      SELECT c."CardId" AS "cardId", c."IsShiny" AS "isShiny", c."ShinyBonusSide" AS "shinyBonusSide", CASE
          WHEN c."IsShiny" THEN c."CardId" || '~' || c."ShinyBonusSide"
          ELSE c."CardId"
      END AS "cardToken", c."Quantity" AS quantity, c."FirstAcquiredUtc" AS "firstAcquiredUtc"
      FROM "CardGameCollection" AS c
      WHERE c."UserId" = @profile_UserId AND c."Quantity" > 0
      ORDER BY c."CardId", c."IsShiny", c."ShinyBonusSide"
