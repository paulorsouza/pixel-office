{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Auth": {
    "_comment": "Em produção/beta: DevBypass=false (senão o X-User-Id vira porta dos fundos) e JwtKey via variável de ambiente. Google* é opcional — as contas locais funcionam sem ele e aceitam o vínculo depois. Ver docs/PLANO_AUTH.md.",
    "DevBypass": true,
    "PasswordEnabled": true,
    "AllowRegistration": true,
    "HostedDomain": "",
    "GoogleClientId": "",
    "GoogleClientSecret": "",
    "GoogleRedirectUri": "http://localhost:5210/auth/google/callback",
    "Scopes": "openid email profile",
    "OfflineAccess": false,
    "JwtKey": "dev-only-insecure-key-change-me_at-least-32-bytes!!",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 14,
    "AllowedOrigins": [],
    "AdminEmails": [],
    "SeedEmailLinks": {}
  }
