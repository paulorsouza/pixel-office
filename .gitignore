# ---------- Build .NET ----------
**/bin/
**/obj/
*.user

# ---------- Dados de runtime ----------
# office.db é recriado e populado (seed) na primeira execução — apagar reseta tudo
*.db
*.db-shm
*.db-wal

# ---------- Docker / segredos ----------
.env
deploy/beta.env
# binários baixados (caddy/cloudflared) — não versionar
deploy/*.exe
**/cloudflared.exe
**/caddy.exe
# artefatos de dados do Caddy/Postgres se algum dia forem montados em bind local
deploy/caddy_data/
deploy/caddy_config/

# ---------- Logs ----------
livekit/*.log
**/Logs/*.png
**/Logs/*.log

# ---------- Unity ----------
# (office-unity tem o seu próprio .gitignore; isto aqui é reforço)
office-unity/Library/
office-unity/Temp/
office-unity/Logs/
office-unity/UserSettings/
office-unity/Build/
office-unity/Builds/
office-unity/*.csproj
office-unity/*.sln
office-unity/.vs/

# ---------- Node ----------
node_modules/
package-lock.json
/.tmp/

# ---------- Assets ----------
# Os packs LimeZu crus e seus backups locais NÃO são versionados — ver ASSETS.md.
# O wildcard também protege cópias como /LimeZu 2/ e /LimeZu.zip.
/LimeZu*/
/LimeZu*.zip
# Os assets já recortados que o cliente carrega SÃO versionados (client-web/assets/).

# ---------- SO ----------
Thumbs.db
desktop.ini
.DS_Store

# ---------- Tiled ----------
# Estado pessoal da interface; mapas .tmj, projeto e tilesets são versionados.
*.tiled-session
